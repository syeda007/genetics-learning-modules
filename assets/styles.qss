/*
 * GENETICS LEARNING SYSTEM — PREMIUM LIGHT THEME v4.0
 * Canvas #f8f9fc  Surface #ffffff  Primary #6366f1
 * Teal #0d9488  Green #059669  Red #dc2626
 * Text #1a1d2e  Muted #64748b  Border #e8eaf2
 */

QMainWindow, QDialog {
    background-color: #f8f9fc; color: #1a1d2e;
    font-family: "Segoe UI Variable", "Segoe UI", "Inter", sans-serif; font-size: 11px;
}
QWidget { color: #1a1d2e; font-family: "Segoe UI Variable", "Segoe UI", "Inter", sans-serif; font-size: 11px; background-color: transparent; }
QMainWindow > QWidget { background-color: #f8f9fc; }
QLabel { background: transparent; color: #1a1d2e; }

/* CARDS */
QFrame#card { background-color: #ffffff; border: 1.5px solid #e8eaf2; border-radius: 12px; }
QFrame#card-accent { background-color: #ffffff; border: 1.5px solid #e8eaf2; border-left: 4px solid #6366f1; border-radius: 12px; }
QFrame#card-teal { background-color: #ffffff; border: 1.5px solid #ccfbf1; border-left: 4px solid #0d9488; border-radius: 12px; }
QFrame#card-green { background-color: #ffffff; border: 1.5px solid #bbf7d0; border-left: 4px solid #059669; border-radius: 12px; }
QFrame#telemetry-bar { background-color: #ffffff; border-bottom: 1px solid #e8eaf2; }

/* VERDICT PANELS */
QFrame#verdict-correct { background-color: #f0fdf4; border: 1.5px solid #86efac; border-left: 5px solid #059669; border-radius: 10px; }
QFrame#verdict-incorrect { background-color: #fef2f2; border: 1.5px solid #fca5a5; border-left: 5px solid #dc2626; border-radius: 10px; }
QFrame#verdict-neutral { background-color: #f8fafc; border: 1.5px dashed #c7d2fe; border-radius: 10px; }

/* BUTTONS */
QPushButton { background-color: #ffffff; color: #374151; border: 1.5px solid #d1d5db; border-radius: 8px; padding: 7px 16px; font-size: 11px; font-weight: 600; }
QPushButton:hover { background-color: #f5f3ff; border-color: #a5b4fc; color: #4f46e5; }
QPushButton:pressed { background-color: #eef2ff; border-color: #6366f1; }
QPushButton:disabled { background-color: #f9fafb; color: #9ca3af; border-color: #e5e7eb; }
QPushButton#btn-primary { background-color: #6366f1; color: #ffffff; border: none; border-radius: 8px; padding: 9px 22px; font-weight: 700; }
QPushButton#btn-primary:hover { background-color: #4f46e5; }
QPushButton#btn-primary:pressed { background-color: #4338ca; }
QPushButton#btn-teal { background-color: #0d9488; color: #ffffff; border: none; border-radius: 8px; padding: 9px 20px; font-weight: 700; }
QPushButton#btn-teal:hover { background-color: #0f766e; }
QPushButton#btn-secondary { background-color: #eef2ff; color: #4f46e5; border: 1.5px solid #c7d2fe; font-weight: 700; border-radius: 8px; padding: 7px 16px; }
QPushButton#btn-secondary:hover { background-color: #e0e7ff; }
QPushButton#btn-danger { background-color: #fef2f2; color: #dc2626; border: 1.5px solid #fca5a5; font-weight: 700; border-radius: 8px; padding: 7px 16px; }
QPushButton#btn-danger:hover { background-color: #fee2e2; }
QPushButton#btn-back { background-color: #f8fafc; color: #64748b; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 6px 14px; font-weight: 600; font-size: 10px; }
QPushButton#btn-back:hover { background-color: #f1f5f9; color: #334155; }

/* INPUTS */
QLineEdit, QSpinBox, QDoubleSpinBox { background-color: #ffffff; color: #1a1d2e; border: 1.5px solid #d1d5db; border-radius: 8px; padding: 7px 12px; font-size: 12px; font-weight: 500; selection-background-color: #6366f1; selection-color: #ffffff; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #6366f1; background-color: #fafafe; }
QComboBox { background-color: #ffffff; color: #1a1d2e; border: 1.5px solid #d1d5db; border-radius: 8px; padding: 7px 12px; font-size: 11px; font-weight: 600; min-width: 80px; }
QComboBox:focus, QComboBox:on { border-color: #6366f1; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 22px; border-left: 1px solid #e5e7eb; }
QComboBox QAbstractItemView { background-color: #ffffff; border: 1.5px solid #c7d2fe; border-radius: 8px; color: #1a1d2e; selection-background-color: #eef2ff; selection-color: #4f46e5; padding: 4px; outline: none; }

/* TEXT */
QTextEdit, QPlainTextEdit { background-color: #fafafe; color: #1a1d2e; border: 1.5px solid #e0e7ff; border-radius: 8px; font-family: "Fira Code","Consolas",monospace; font-size: 10px; padding: 8px; }

/* TABLES */
QTableWidget, QTableView { background-color: #ffffff; alternate-background-color: #f8faff; border: 1.5px solid #e0e7ff; border-radius: 8px; gridline-color: #e8eaf2; color: #1a1d2e; font-size: 11px; selection-background-color: #eef2ff; selection-color: #4f46e5; }
QHeaderView::section { background-color: #f5f7ff; color: #6366f1; font-weight: 800; font-size: 10px; border: none; border-right: 1px solid #e0e7ff; border-bottom: 2px solid #c7d2fe; padding: 7px 12px; }
QHeaderView::section:vertical { color: #4f46e5; font-weight: 800; }
QTableCornerButton::section { background-color: #f5f7ff; border: 1px solid #e0e7ff; }

/* TABS */
QTabWidget::pane { border: 1.5px solid #e0e7ff; border-radius: 8px; background-color: #ffffff; top: -1px; }
QTabBar::tab { background-color: #f5f7ff; color: #64748b; border: 1.5px solid #e0e7ff; border-bottom: none; border-top-left-radius: 7px; border-top-right-radius: 7px; padding: 7px 16px; margin-right: 2px; font-size: 10px; font-weight: 700; }
QTabBar::tab:selected { background-color: #ffffff; color: #4f46e5; font-weight: 800; border-top: 3px solid #6366f1; }
QTabBar::tab:hover:!selected { background-color: #eef2ff; color: #374151; }

/* SCROLLBARS */
QScrollBar:vertical { background: #f8f9fc; width: 7px; border-radius: 4px; margin: 0; }
QScrollBar::handle:vertical { background: #c7d2fe; min-height: 24px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #6366f1; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #f8f9fc; height: 7px; border-radius: 4px; margin: 0; }
QScrollBar::handle:horizontal { background: #c7d2fe; min-width: 24px; border-radius: 4px; }
QScrollBar::handle:horizontal:hover { background: #6366f1; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* SLIDER */
QSlider::groove:horizontal { border: none; height: 6px; background: #e0e7ff; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #6366f1; border-radius: 3px; }
QSlider::handle:horizontal { background: #6366f1; border: 2px solid #ffffff; width: 16px; height: 16px; margin: -5px 0; border-radius: 8px; }

/* PROGRESS */
QProgressBar { border: none; border-radius: 5px; background-color: #e0e7ff; text-align: center; color: #4f46e5; font-size: 9px; font-weight: 800; min-height: 12px; }
QProgressBar::chunk { background-color: #6366f1; border-radius: 5px; }

/* STATUS / TOOLTIP / SPLITTER */
QStatusBar { background-color: #ffffff; color: #94a3b8; border-top: 1px solid #e8eaf2; font-size: 10px; font-weight: 600; }
QToolTip { background-color: #1e1b4b; color: #f5f3ff; border: none; border-radius: 6px; padding: 6px 10px; font-size: 10px; font-weight: 600; }
QSplitter::handle { background-color: #e0e7ff; width: 2px; height: 2px; }
QSplitter::handle:hover { background-color: #6366f1; }

/* RADIO / CHECKBOX */
QRadioButton, QCheckBox { color: #374151; font-size: 11px; spacing: 7px; }
QRadioButton::indicator { width: 15px; height: 15px; border-radius: 8px; border: 2px solid #c7d2fe; background-color: #ffffff; }
QRadioButton::indicator:checked { border: 5px solid #6366f1; background-color: #ffffff; }
QCheckBox::indicator { width: 15px; height: 15px; border-radius: 4px; border: 2px solid #c7d2fe; background-color: #ffffff; }
QCheckBox::indicator:checked { background-color: #6366f1; border-color: #6366f1; }

/* SCROLL AREA */
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
